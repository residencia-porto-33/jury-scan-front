# ATENÇÃO: toda variável com prefixo VITE_ vai para o bundle e é PÚBLICA.
# NUNCA coloque aqui chave de API de IA, token ou segredo — eles ficam só no
# servidor (US04). O frontend só conhece a URL pública do backend.

# URL base do backend FastAPI (sem barra final).
VITE_API_BASE_URL=http://localhost:8000

# Timeout da chamada POST /api/analyze, em ms. Deve ficar um pouco acima do
# timeout do backend com o serviço de IA.
VITE_REQUEST_TIMEOUT_MS=90000

# Limites de entrada. TODO(backend): confirmar que batem com a validação Pydantic.
VITE_MIN_INPUT_CHARS=200
VITE_MAX_INPUT_CHARS=200000
VITE_MAX_PDF_MB=20

# Média mínima de caracteres não-brancos por página para considerar que o PDF tem texto.
VITE_PDF_MIN_CHARS_PER_PAGE=50

# true = intercepta /api/analyze com MSW no navegador (desenvolvimento sem backend).
# Prefira `npm run dev:mock`, que já usa .env.mock.
VITE_USE_MOCKS=false
